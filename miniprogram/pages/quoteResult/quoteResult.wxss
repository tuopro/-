/* ==================== pages/quoteResult/quoteResult.wxss ==================== */

.page {
  padding-bottom: 140rpx;
}

/* Canvas — 屏幕内不可见，不占空间 */
.hidden-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

/* 加载中 */
.loading-wrap {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 错误提示 */
.error-card {
  margin: 48rpx 24rpx;
  padding: 40rpx;
  background: #EFF6FF;
  border-radius: 16rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.error-icon {
  font-size: 60rpx;
  color: #2563EB;
  font-weight: 700;
}
.error-text {
  font-size: 28rpx;
  color: #1D4ED8;
}

/* ======== 不含运费：报价总价大号卡片 ======== */
.big-total-card {
  margin: 24rpx;
  padding: 48rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  text-align: center;
}
.big-total-label {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.big-total-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #2563EB;
}
.big-total-notax {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ======== 广告语 ======== */
.slogan-bar {
  margin: 24rpx 24rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  letter-spacing: 2rpx;
}

/* ======== 产品表格 ======== */
.table-header, .table-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 26rpx;
}
.table-header {
  color: #999;
  border-bottom: 2rpx solid #eee;
  padding-bottom: 12rpx;
}
.table-row:last-child {
  border-bottom: none;
}

.col-spec  { flex: 2; }
.col-price { flex: 1.2; text-align: right; }
.col-qty   { flex: 0.8; text-align: center; }
.col-weight{ flex: 1.2; text-align: right; }
.col-sub   { flex: 1.2; text-align: right; font-weight: 600; color: #333; }
.col-dsub  { flex: 1.2; text-align: right; font-weight: 700; color: #2563EB; }

.total-line-original .total-value.original {
  text-decoration: line-through;
  color: #999;
  font-size: 26rpx;
  font-weight: 400;
}

.table-footer {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #eee;
}
.total-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.total-line-sub {
  font-size: 26rpx;
}
.total-label {
  color: #666;
}
.total-value {
  font-weight: 600;
  color: #333;
}
.total-line:not(.total-line-original):not(.total-line-sub) .total-value,
.total-line:first-child:not(.total-line-original) .total-value {
  font-size: 36rpx;
  color: #2563EB;
  font-weight: 700;
}

/* ======== 运费对比区 ======== */
.freight-compare {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx;
  align-items: stretch;
}
.freight-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  overflow: hidden;
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.freight-header {
  text-align: center;
  padding: 18rpx 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
}
.freight-express {
  background: linear-gradient(135deg, #2563EB, #3B82F6);
}
.freight-logistics {
  background: linear-gradient(135deg, #0891B2, #06B6D4);
}
.freight-body {
  padding: 20rpx 16rpx;
}
.freight-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
  font-size: 24rpx;
}
.fr-label {
  color: #888;
}
.fr-value {
  color: #333;
  font-weight: 500;
}
.freight-highlight {
  border-top: 1rpx solid #f0f0f0;
  margin-top: 8rpx;
  padding-top: 14rpx;
}
.freight-highlight .fr-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
}
.freight-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}
.fr-empty {
  color: #ccc;
  font-size: 26rpx;
}
.freight-placeholder {
  height: 44rpx;
}
.freight-total {
  margin-top: 16rpx;
  padding: 14rpx 0;
  border-top: 2rpx solid #eee;
  text-align: center;
}
.ft-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}
.ft-value {
  font-size: 38rpx;
  font-weight: 700;
  color: #2563EB;
}

/* 不含税总价行 */
.total-line-notax .total-value {
  font-size: 24rpx !important;
  color: #9CA3AF !important;
  font-weight: 400 !important;
}
.freight-total-notax {
  border-top: none;
  margin-top: 0;
  padding-top: 4rpx;
}
.ft-value-notax {
  font-size: 26rpx;
  font-weight: 500;
  color: #9CA3AF;
}

/* ======== 信息条 ======== */
.info-bar {
  margin: 24rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #666;
}
.info-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 8rpx 0;
}
.info-row:first-child {
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
.info-icon {
  font-size: 30rpx;
}

/* ======== 按钮区 ======== */
.copy-area {
  margin: 24rpx;
}
.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: #fff;
  color: #2563EB;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: 3rpx solid #2563EB;
}
.copy-btn:active {
  background: #EFF6FF;
}

/* 生成图片按钮 — 实心蓝色 */
.image-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2563EB, #3B82F6);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(37,99,235,0.3);
}
.image-btn:active {
  opacity: 0.85;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
}
