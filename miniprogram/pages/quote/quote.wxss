/* ==================== pages/quote/quote.wxss ==================== */

.page {
  padding-bottom: 140rpx;
}

/* 页头 */
.header {
  padding: 48rpx 32rpx 24rpx;
  text-align: center;
}
.header-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #2563EB;
  margin-bottom: 8rpx;
}
.header-sub {
  font-size: 26rpx;
  color: #999;
}

/* 卡片标题 */
.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #eee;
}

/* ======== 产品行 ======== */
.product-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

/* 通用 picker 显示条 */
.picker-display {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: #fafafa;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.picker-placeholder {
  color: #bbb;
}

/* 产品 picker */
.product-picker {
  flex: 1;
}

/* 数量 */
.quantity-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.qty-label {
  font-size: 28rpx;
  color: #999;
}
.qty-input {
  width: 100rpx;
  height: 72rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  text-align: center;
  font-size: 28rpx;
  background: #fafafa;
  padding: 0 8rpx;
}

/* 删除按钮 */
.del-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ccc;
  border-radius: 50%;
  flex-shrink: 0;
}
.del-btn:active {
  color: #2563EB;
  background: #EFF6FF;
}
.del-btn-placeholder {
  visibility: hidden;
}

/* 添加按钮 */
.add-row-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 72rpx;
  border: 2rpx dashed #ddd;
  border-radius: 10rpx;
  color: #2563EB;
  font-size: 28rpx;
  margin-top: 8rpx;
}
.add-row-btn:active {
  background: #EFF6FF;
}
.add-row-disabled {
  color: #ccc;
  border-color: #eee;
}
.add-icon {
  font-size: 36rpx;
  font-weight: 300;
}

/* ======== 客户折扣 ======== */
.discount-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.discount-input-wrap {
  margin-top: 20rpx;
}
.discount-input {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  font-size: 28rpx;
  background: #fafafa;
  box-sizing: border-box;
}
.discount-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #2563EB;
}

/* 含运费开关 */
.switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #eee;
}
.switch-label {
  font-size: 28rpx;
  color: #333;
}

/* ======== 地址 picker ======== */
.region-display {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  background: #fafafa;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}
.region-placeholder {
  color: #bbb;
}
.arrow {
  color: #ccc;
  font-size: 28rpx;
}

/* ======== 提交按钮 ======== */
.submit-area {
  padding: 32rpx 24rpx;
}
.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #2563EB, #3B82F6);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(37,99,235,0.3);
}
.submit-btn:active {
  opacity: 0.85;
  box-shadow: 0 4rpx 12rpx rgba(37,99,235,0.2);
}
