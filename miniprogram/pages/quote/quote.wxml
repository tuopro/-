<!-- ==================== pages/quote/quote.wxml ==================== -->
<view class="page">
  <!-- 页头标题 -->
  <view class="header">
    <text class="header-title">德赛线槽快速报价</text>
    <text class="header-sub">填写产品明细，一键生成报价</text>
  </view>

  <!-- 产品明细卡片 -->
  <view class="card">
    <view class="card-title">产品明细</view>

    <view class="product-row"
          wx:for="{{productRows}}"
          wx:key="id"
          wx:for-item="row">
      <picker class="product-picker"
              mode="selector"
              range="{{productRange}}"
              range-key="label"
              value="{{row.pickerIndex}}"
              bindchange="onProductChange"
              data-rowid="{{row.id}}">
        <view class="picker-display {{row.spec ? '' : 'picker-placeholder'}}">
          {{row.spec || '请选择产品'}}
        </view>
      </picker>

      <view class="quantity-wrap">
        <text class="qty-label">×</text>
        <input class="qty-input"
               type="number"
               value="{{row.quantity}}"
               min="1"
               placeholder="1"
               bindinput="onQuantityInput"
               bindblur="onQuantityBlur"
               data-rowid="{{row.id}}"/>
      </view>

      <view class="del-btn"
            wx:if="{{productRows.length > 1}}"
            bindtap="removeRow"
            data-rowid="{{row.id}}">
        <text>×</text>
      </view>
      <view class="del-btn del-btn-placeholder" wx:else></view>
    </view>

    <view class="add-row-btn"
          wx:if="{{productRows.length < 10}}"
          bindtap="addRow">
      <text class="add-icon">+</text>
      <text>添加产品</text>
    </view>
    <view class="add-row-btn add-row-disabled" wx:else>
      <text>已达上限（10行）</text>
    </view>
  </view>

  <!-- 客户折扣卡片 -->
  <view class="card">
    <view class="card-title">客户折扣</view>
    <picker mode="selector"
            range="{{discountOptions}}"
            range-key="label"
            value="{{discountTypeIndex}}"
            bindchange="onDiscountTypeChange">
      <view class="picker-display discount-picker">
        <text>{{discountOptions[discountTypeIndex].label}}</text>
        <text class="arrow">▸</text>
      </view>
    </picker>

    <view class="discount-input-wrap" wx:if="{{discountOptions[discountTypeIndex].value === -1}}">
      <input class="discount-input"
             type="digit"
             value="{{discountInput}}"
             placeholder="请输入折扣，例如 9.5 表示 9.5折"
             bindblur="onDiscountBlur"/>
      <text class="discount-hint" wx:if="{{discountCoefficient < 1}}">
        折后系数：{{discountCoefficient}}
      </text>
    </view>

    <!-- 含运费开关 -->
    <view class="switch-row">
      <text class="switch-label">含运费</text>
      <switch checked="{{includeFreight}}"
              bindchange="onFreightSwitch"
              color="#2563EB"/>
    </view>
  </view>

  <!-- 收货地址卡片（仅含运费时显示） -->
  <view class="card" wx:if="{{includeFreight}}">
    <view class="card-title">收货地址</view>
    <picker mode="region"
            value="{{region}}"
            bindchange="onRegionChange">
      <view class="region-display {{province ? '' : 'region-placeholder'}}">
        <text>{{province ? province + ' ' + city : '请选择省/市'}}</text>
        <text class="arrow">▸</text>
      </view>
    </picker>
  </view>

  <!-- 立即报价按钮 -->
  <view class="submit-area">
    <button class="submit-btn" bindtap="onSubmit">立即报价</button>
  </view>
</view>
