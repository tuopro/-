/* ==================== pages/password/password.wxss ==================== */

.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* Logo 区 */
.logo-area {
  text-align: center;
  margin-bottom: 60rpx;
}
.logo-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.logo-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2563EB;
}

/* 表单卡片 */
.form-card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  text-align: center;
}

/* 输入框 */
.password-input {
  width: 100%;
  height: 96rpx;
  border: 3rpx solid #2563EB;
  border-radius: 12rpx;
  text-align: center;
  font-size: 44rpx;
  letter-spacing: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #F9FAFB;
}

/* 显示/隐藏 */
.toggle-eye {
  text-align: right;
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: #999;
}

/* 按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #2563EB, #3B82F6);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(37,99,235,0.3);
}
.submit-btn:active {
  opacity: 0.85;
}
