<!-- ==================== pages/password/password.wxml ==================== -->
<view class="page">
  <view class="logo-area">
    <text class="logo-icon">🔐</text>
    <text class="logo-title">德赛线槽快速报价</text>
  </view>

  <view class="form-card">
    <text class="form-label">请输入报价口令</text>
    <input class="password-input"
           type="number"
           maxlength="6"
           value="{{password}}"
           placeholder="最多6位数字"
           password="{{showPassword ? false : true}}"
           bindinput="onInput"
           focus="{{true}}"/>
    <view class="toggle-eye" bindtap="togglePassword">
      <text>{{showPassword ? '🙈 隐藏' : '👁 显示'}}</text>
    </view>
    <button class="submit-btn" bindtap="onSubmit" loading="{{loading}}">确认</button>
  </view>
</view>
