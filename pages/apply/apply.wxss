.page {
  min-height: 100vh;
  padding: 56rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.logo-area {
  text-align: center;
  margin-bottom: 44rpx;
}

.logo-mark {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #0F3D75, #0A84FF);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(10, 64, 130, 0.22);
}

.logo-title {
  display: block;
  font-size: 42rpx;
  font-weight: 850;
  color: #1D1D1F;
  margin-bottom: 10rpx;
}

.logo-sub {
  display: block;
  max-width: 560rpx;
  margin: 0 auto;
  font-size: 26rpx;
  color: #6E6E73;
  line-height: 1.55;
}

.form-card {
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 18rpx 46rpx rgba(31, 41, 55, 0.07);
}

.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  display: block;
  font-size: 27rpx;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  font-weight: 800;
}

.required {
  color: #FF3B30;
}

.form-input,
.form-textarea {
  width: 100%;
  padding: 0 22rpx;
  border: 1rpx solid #E6E9EF;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #1D1D1F;
  background: #F7F8FA;
  box-sizing: border-box;
}

.form-input {
  height: 84rpx;
}

.form-textarea {
  min-height: 160rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.form-input:focus,
.form-textarea:focus {
  border-color: #0A84FF;
  background: #fff;
}

.submit-btn {
  width: 100%;
  height: 94rpx;
  line-height: 94rpx;
  background: linear-gradient(135deg, #0A84FF, #0066CC);
  color: #fff;
  font-size: 32rpx;
  font-weight: 850;
  border-radius: 24rpx;
  border: none;
  box-shadow: 0 14rpx 30rpx rgba(10, 132, 255, 0.26);
  margin-top: 14rpx;
}

.submit-btn[disabled] {
  background: #C7C7CC;
  box-shadow: none;
}

.submit-btn:active {
  opacity: 0.86;
}

.privacy-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
}

.privacy-popup {
  width: 100%;
  max-height: 80vh;
  background: #fff;
  border-radius: 30rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 60rpx rgba(15, 23, 42, 0.18);
}

.privacy-title {
  padding: 38rpx 32rpx 24rpx;
  font-size: 34rpx;
  font-weight: 850;
  color: #1D1D1F;
  text-align: center;
}

.privacy-body {
  padding: 0 32rpx 36rpx;
  overflow-y: auto;
  flex: 1;
}

.privacy-text {
  font-size: 26rpx;
  color: #6E6E73;
  line-height: 1.7;
}

.privacy-text-gap {
  display: block;
  margin-top: 24rpx;
}

.privacy-links {
  display: flex;
  gap: 36rpx;
  margin-top: 24rpx;
}

.privacy-link {
  font-size: 28rpx;
  color: #0A67CC;
  font-weight: 700;
}

.privacy-check-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 32rpx;
}

.privacy-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #C7C7CC;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
}

.privacy-checkbox-checked {
  background: #0A84FF;
  border-color: #0A84FF;
}

.privacy-check-label {
  font-size: 26rpx;
  color: #3A3A3C;
  flex: 1;
}

.privacy-confirm-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 32rpx;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 22rpx;
  border: none;
  background: #C7C7CC;
  color: #fff;
}

.privacy-confirm-active {
  background: linear-gradient(135deg, #0A84FF, #0066CC);
  box-shadow: 0 12rpx 26rpx rgba(10, 132, 255, 0.22);
}

.privacy-confirm-active:active {
  opacity: 0.86;
}
