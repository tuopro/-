<view class="page">
  <view class="logo-area">
    <view class="logo-mark">D</view>
    <text class="logo-title">CNDES 德赛线槽报价</text>
    <text class="logo-sub">提交企业信息，审核通过后即可使用厂家报价工具</text>
  </view>

  <view class="form-card">
    <view class="form-item">
      <text class="form-label">公司名称 <text class="required">*</text></text>
      <input class="form-input"
             value="{{companyName}}"
             placeholder="请输入公司名称"
             bindinput="onCompanyInput"/>
    </view>

    <view class="form-item">
      <text class="form-label">联系人 <text class="required">*</text></text>
      <input class="form-input"
             value="{{contactName}}"
             placeholder="请输入联系人姓名"
             bindinput="onContactInput"/>
    </view>

    <view class="form-item">
      <text class="form-label">手机号 <text class="required">*</text></text>
      <input class="form-input"
             type="number"
             maxlength="11"
             value="{{phone}}"
             placeholder="请输入11位手机号"
             bindinput="onPhoneInput"/>
    </view>

    <view class="form-item">
      <text class="form-label">申请说明</text>
      <textarea class="form-textarea"
                value="{{remark}}"
                placeholder="选填，可说明您的需求"
                bindinput="onRemarkInput"
                auto-height/>
    </view>

    <button class="submit-btn"
            bindtap="onSubmit"
            loading="{{submitting}}"
            disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交申请'}}
    </button>
  </view>
</view>

<view class="privacy-overlay" wx:if="{{showPrivacy}}" catchtouchmove="noop">
  <view class="privacy-popup">
    <view class="privacy-title">用户隐私与协议授权</view>

    <view class="privacy-body">
      <text class="privacy-text">为了更好地为您提供报价服务，我们将收集您的公司名称、联系人姓名及手机号码。上述信息仅用于生成报价单及后续业务联系，不会用于其他用途。</text>

      <text class="privacy-text privacy-text-gap">请您在使用前阅读并同意以下协议：</text>

      <view class="privacy-links">
        <text class="privacy-link" bindtap="showServiceAgreement">《用户服务协议》</text>
        <text class="privacy-link" bindtap="showPrivacyPolicy">《隐私政策》</text>
      </view>

      <view class="privacy-check-row" bindtap="onAgreeCheck">
        <view class="privacy-checkbox {{privacyChecked ? 'privacy-checkbox-checked' : ''}}">
          <text wx:if="{{privacyChecked}}">✓</text>
        </view>
        <text class="privacy-check-label">我已阅读并同意《用户服务协议》与《隐私政策》</text>
      </view>

      <button class="privacy-confirm-btn {{privacyChecked ? 'privacy-confirm-active' : ''}}"
              bindtap="onPrivacyConfirm"
              disabled="{{!privacyChecked}}">同意并提交</button>
    </view>
  </view>
</view>
