<view class="page">
  <view class="brand-bar">
    <view><text class="brand-name">CNDES 德赛线槽</text><text class="brand-sub">厂家报价工具</text></view>
    <button wx:if="{{isAdmin}}" class="text-button admin-entry" bindtap="goAdmin">管理</button>
  </view>
  <view class="mode-tabs">
    <button class="mode-tab {{quoteMode === 'standard' ? 'is-active' : ''}}" data-mode="standard" bindtap="onQuoteModeTap">标准报价</button>
    <button class="mode-tab {{quoteMode === 'fixed' ? 'is-active' : ''}}" data-mode="fixed" bindtap="onQuoteModeTap">定长报价</button>
    <button class="mode-tab {{quoteMode === 'foreign' ? 'is-active' : ''}}" data-mode="foreign" bindtap="onQuoteModeTap">外贸 FOB</button>
  </view>
  <view class="section-tabs">
    <button class="section-tab {{uiSection === 'select' ? 'is-current' : ''}}" data-section="select" bindtap="onUISectionTap">快速选品</button>
    <button class="section-tab {{uiSection === 'cart' ? 'is-current' : ''}}" data-section="cart" bindtap="onUISectionTap">报价清单<text class="count">{{cart.length}}</text></button>
  </view>

  <view hidden="{{uiSection !== 'select'}}" class="{{uiSection !== 'select' ? 'ui-hidden' : ''}}">
    <view class="search-row">
      <view class="search-field {{uiSearchActive ? 'search-field-active' : ''}}">
        <view class="search-icon"></view>
        <input class="search-input" type="text" value="{{uiSpecQuery}}" maxlength="40" placeholder="搜索规格：6040 / 60×40" placeholder-class="input-placeholder" confirm-type="search" bindfocus="onSpecSearchFocus" bindinput="onSpecSearchInput" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="24"/>
        <button wx:if="{{uiSpecQuery}}" class="clear-search" bindtap="onSpecSearchClear" aria-label="清空搜索">×</button>
      </view>
      <button wx:if="{{uiSearchActive}}" class="text-button search-cancel" bindtap="onSpecSearchCancel">取消</button>
    </view>
    <view wx:if="{{uiSearchActive}}" class="search-panel">
      <text wx:if="{{!uiSpecQuery}}" class="helper-text">输入高×宽，支持 6040、60×40、60x40</text>
      <block wx:else>
        <text class="helper-text">{{uiSpecResults.length ? '匹配到 ' + uiSpecResults.length + ' 个规格' : '未找到该规格'}}</text>
        <scroll-view wx:if="{{uiSpecResults.length}}" class="search-results" style="height: {{uiSpecResults.length === 1 ? 228 : 480}}rpx;" scroll-y>
          <button wx:for="{{uiSpecResults}}" wx:key="key" class="search-result" data-height="{{item.height}}" data-width="{{item.width}}" bindtap="onSpecSearchSelect">
            <view class="result-heading"><text class="result-spec">{{item.spec}} mm</text><text class="link-text">选择 ›</text></view>
            <text class="dimension-label">{{item.dimensionLabel}}</text>
            <text class="helper-text result-teeth">{{item.teethLabel}}</text>
          </button>
        </scroll-view>
        <text wx:else class="helper-text empty-explanation">请检查高宽顺序，或使用下方手动选择。</text>
      </block>
      <button class="manual-link" bindtap="onShowManualSpecs">改用高度、宽度选择 ›</button>
    </view>

    <view hidden="{{uiSearchActive}}" class="{{uiSearchActive ? 'ui-hidden' : ''}}">
      <view class="panel spec-panel">
        <view class="panel-heading"><text class="panel-title">选择产品</text><button class="text-button" bindtap="onToggleDimensionsHelp">尺寸怎么看 {{uiDimensionsHelp ? '⌃' : '›'}}</button></view>
        <view wx:if="{{uiDimensionsHelp}}" class="help-note">规格按“高度 × 宽度”表示，单位为 mm。例如 60×40 表示高 60 mm、宽 40 mm；与 40×60 是不同规格。</view>
        <view wx:if="{{uiCompactSpec && sampleSpec}}" class="selected-spec">
          <view><text class="result-spec">已选 {{sampleSpec}} mm</text><text class="dimension-label">高 {{selectedHeight}} × 宽 {{selectedWidth}} mm</text></view>
          <button class="text-button" bindtap="onShowManualSpecs">更换规格 ›</button>
        </view>
        <view wx:else>
          <text class="field-label">高度 <text class="unit">mm</text></text>
          <view class="dimension-options"><button wx:for="{{heightList}}" wx:key="*this" class="option {{selectedHeight === item ? 'option-selected' : ''}}" data-value="{{item}}" bindtap="onHeightTap">{{item}}</button></view>
          <block wx:if="{{widthList.length}}">
            <text class="field-label">宽度 <text class="unit">mm</text></text>
            <view class="dimension-options"><button wx:for="{{widthList}}" wx:key="*this" class="option {{selectedWidth === item ? 'option-selected' : ''}}" data-value="{{item}}" bindtap="onWidthTap">{{item}}</button></view>
          </block>
          <view wx:if="{{sampleSpec}}" class="dimension-note">当前规格：高 {{selectedHeight}} × 宽 {{selectedWidth}} mm</view>
        </view>
        <view class="field-heading"><text class="field-label">齿形</text><button class="text-button" bindtap="onOpenToothGuide">齿型怎么选 ›</button></view>
        <view wx:if="{{sampleTeeth.length}}" class="teeth-options"><button wx:for="{{sampleTeeth}}" wx:key="*this" class="option {{selectedTeeth === item ? 'option-selected' : ''}}" data-value="{{item}}" bindtap="onTeethTap">{{item}}</button></view>
        <view wx:if="{{sampleColors.length > 1}}">
          <text class="field-label">颜色</text>
          <view class="teeth-options"><button wx:for="{{sampleColors}}" wx:key="*this" class="option {{selectedColor === item ? 'option-selected' : ''}}" data-value="{{item}}" bindtap="onColorTap">{{item}}</button></view>
        </view>
        <text wx:elif="{{sampleColors.length === 1}}" class="single-color">颜色：{{sampleColors[0]}}</text>
        <view wx:if="{{sampleSpec && selectedTeeth}}" class="current-price"><text>{{quoteMode === 'foreign' ? '人民币内部米价' : '当前米价（折扣前）'}}</text><text class="price-text">¥{{samplePrice}} / 米</text></view>
      </view>
      <view class="panel quantity-panel" wx:if="{{sampleSpec && selectedTeeth && (selectedColor || sampleColors.length <= 1)}}">
        <block wx:if="{{quoteMode !== 'fixed'}}">
          <text class="panel-title">采购数量</text>
          <view class="number-field"><input type="digit" value="{{sampleMeters}}" placeholder="请输入米数" bindinput="onMetersInput" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="100"/><text>米</text></view>
          <text class="helper-text">{{sampleBoxMeters}} 米 / 箱</text>
          <text wx:if="{{sampleMeterHint}}" class="helper-text meter-hint">{{sampleMeterHint}}</text>
          <text wx:if="{{quoteMode === 'foreign'}}" class="helper-text meter-hint">宁波港口运费 ¥20/箱，按每箱米数摊入单价</text>
        </block>
        <block wx:else>
          <text class="panel-title">定长输入</text>
          <text class="field-label">单根长度</text>
          <view class="number-field"><input type="digit" value="{{fixedLength}}" placeholder="请输入单根长度" bindinput="onFixedLengthInput" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="100"/><text>米/根</text></view>
          <text class="field-label">采购数量</text>
          <view class="number-field"><input type="number" value="{{fixedQuantity}}" placeholder="请输入根数" bindinput="onFixedQuantityInput" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="100"/><text>根</text></view>
          <text class="helper-text">单根长度不超过 2 米</text>
          <text wx:if="{{fixedLengthHint}}" class="helper-text meter-hint">{{fixedLengthHint}}</text>
        </block>
        <button class="primary-button add-button" bindtap="addToCart">{{quoteMode === 'fixed' ? '加入定长报价' : (quoteMode === 'foreign' ? '加入 FOB 报价' : '加入报价清单')}}</button>
      </view>
    </view>
  </view>

  <view hidden="{{uiSection !== 'cart'}}" class="{{uiSection !== 'cart' ? 'ui-hidden' : ''}}">
    <view id="quote-items" class="list-heading"><text class="panel-title">已选 {{cart.length}} 项产品</text><button class="text-button" data-section="select" bindtap="onUISectionTap">继续添加 ›</button></view>
    <view wx:if="{{!cart.length}}" class="panel empty-state"><text class="panel-title">报价清单还是空的</text><text class="helper-text">先搜索规格或按高度、宽度选择产品。</text><button class="primary-button" data-section="select" bindtap="onUISectionTap">去选产品</button></view>
    <view wx:for="{{cart}}" wx:key="id" class="panel cart-item">
      <view class="item-heading"><view class="item-identity"><text class="item-spec">{{quoteMode === 'foreign' ? item.specification + ' mm' : item.height + '×' + item.width + ' mm'}}</text><text class="helper-text">{{item.teeth}} · {{item.color}}</text><text wx:if="{{item.quoteType === 'fixed'}}" class="helper-text">{{item.fixedLength}} 米/根</text></view><button class="delete-button" data-id="{{item.id}}" bindtap="removeCartItem">删除</button></view>
      <view class="item-pricing">
        <view class="quantity-field"><input wx:if="{{item.quoteType !== 'fixed'}}" type="digit" value="{{item.meters}}" data-id="{{item.id}}" bindblur="onCartMetersInput" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="110"/><input wx:else type="number" value="{{item.quantity}}" data-id="{{item.id}}" bindblur="onCartFixedQuantityInput" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="110"/><text>{{item.quoteType === 'fixed' ? '根' : '米'}}</text></view>
        <view class="item-amount"><text class="helper-text">{{quoteMode === 'foreign' ? 'Amount (USD)' : '原价小计'}}</text><text class="price-text">{{quoteMode === 'foreign' ? '$' + item.amountUsd : '¥' + item.subtotal}}</text></view>
      </view>
      <text class="helper-text unit-price">{{quoteMode === 'foreign' ? '$' + item.fobUnitPriceUsd + ' / m' : '¥' + item.unitPrice + (item.quoteType === 'fixed' ? ' / 根' : ' / 米')}}</text>
    </view>
    <view class="panel" wx:if="{{quoteMode !== 'foreign'}}">
      <picker mode="selector" range="{{discountOptions}}" range-key="label" value="{{discountTypeIndex}}" bindchange="onDiscountTypeChange"><view class="setting-row"><text>客户折扣</text><text class="setting-value">{{discountOptions[discountTypeIndex].label}} ›</text></view></picker>
      <view wx:if="{{discountOptions[discountTypeIndex].value === -1}}" class="custom-discount"><input class="setting-input" type="digit" value="{{discountInput}}" placeholder="例如 9.5 表示 9.5 折" bindblur="onDiscountBlur" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="110"/><text wx:if="{{discountCoefficient < 1}}" class="helper-text">折后系数：{{discountCoefficient}}</text></view>
    </view>
    <view class="panel" wx:if="{{quoteMode === 'foreign'}}">
      <text class="panel-title">外贸内部参数</text>
      <text class="field-label">美元兑人民币汇率</text>
      <view class="exchange-row"><text>1 USD =</text><input class="setting-input rate-input" type="digit" value="{{foreignExchangeRate}}" bindblur="onForeignExchangeRateBlur" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="110"/><text>RMB</text></view>
      <picker mode="selector" range="{{foreignDiscountOptions}}" range-key="label" value="{{foreignDiscountTypeIndex}}" bindchange="onForeignDiscountTypeChange"><view class="setting-row"><text>客户折扣（内部）</text><text class="setting-value">{{foreignDiscountOptions[foreignDiscountTypeIndex].label}} ›</text></view></picker>
      <input wx:if="{{foreignDiscountOptions[foreignDiscountTypeIndex].value === -1}}" class="setting-input" type="digit" value="{{foreignDiscountInput}}" placeholder="例如 8.8 表示 8.8 折" bindblur="onForeignDiscountBlur" bindkeyboardheightchange="onUIKeyboardChange" adjust-position cursor-spacing="110"/>
      <text class="helper-text internal-note">汇率、折扣及人民币价格不会显示在客户报价单中</text>
    </view>
    <view id="delivery-settings" class="panel delivery-panel" wx:if="{{quoteMode !== 'foreign'}}">
      <text class="panel-title">配送设置</text>
      <picker wx:if="{{includeFreight}}" mode="region" value="{{region}}" bindchange="onRegionChange"><view class="setting-row region-row"><text>收货地区</text><text class="setting-value {{province ? '' : 'muted'}}">{{province ? province + ' ' + city : '请选择省 / 市'}} ›</text></view></picker>
      <text class="field-label">配送方式</text>
      <button class="delivery-option {{includeFreight && transportType === 'express' ? 'delivery-selected' : ''}}" data-value="express" bindtap="onUIDeliveryTap"><view class="radio-mark {{includeFreight && transportType === 'express' ? 'radio-selected' : ''}}"></view><view class="delivery-copy"><text>快运送货</text><text class="helper-text">送货上门</text></view><text class="delivery-price">{{!includeFreight ? '选择后计算' : !province || !cart.length ? '待计算' : (freightRule ? '¥' + expressFreight : '暂未配置')}}</text></button>
      <button wx:if="{{quoteMode !== 'fixed'}}" class="delivery-option {{includeFreight && transportType === 'logistics' ? 'delivery-selected' : ''}}" data-value="logistics" bindtap="onUIDeliveryTap"><view class="radio-mark {{includeFreight && transportType === 'logistics' ? 'radio-selected' : ''}}"></view><view class="delivery-copy"><text>物流自提</text><text class="helper-text">到当地物流网点提货</text></view><text class="delivery-price">{{!includeFreight ? '选择后计算' : !province || !cart.length ? '待计算' : (logisticsRule ? '¥' + logisticsFreight : '暂未配置')}}</text></button>
      <button class="delivery-option {{!includeFreight ? 'delivery-selected' : ''}}" data-value="none" bindtap="onUIDeliveryTap"><view class="radio-mark {{!includeFreight ? 'radio-selected' : ''}}"></view><view class="delivery-copy"><text>不计运费</text><text class="helper-text">报价不包含运输费用</text></view></button>
    </view>
    <view class="panel" wx:if="{{cart.length}}">
      <view wx:if="{{quoteMode === 'foreign'}}" class="summary-row"><text>FOB Ningbo Total (USD)</text><text class="price-text">${{foreignTotalUsd}}</text></view>
      <block wx:else>
        <view class="summary-row"><text>{{discountCoefficient < 1 ? '产品折后合计' : '产品总价（含税）'}}</text><text class="price-text">¥{{discountedTotal}}</text></view>
        <view class="summary-row secondary"><text>产品不含税合计</text><text>¥{{noTaxTotal}}</text></view>
        <button class="disclosure" bindtap="onToggleQuoteDetails">{{uiDetailsOpen ? '收起计价明细 ⌃' : '查看计价明细 ›'}}</button>
        <view wx:if="{{uiDetailsOpen}}" class="quote-details">
          <view class="summary-row"><text>产品原价合计</text><text>¥{{productTotal}}</text></view>
          <view class="summary-row"><text>总重量</text><text>{{totalWeight}} kg</text></view>
          <view class="summary-row"><text>{{quoteMode === 'fixed' ? '总根数' : '总件数'}}</text><text>{{totalPieces}} {{quoteMode === 'fixed' ? '根' : '件'}}</text></view>
          <block wx:if="{{includeFreight}}">
            <text class="detail-title">快运送货</text>
            <block wx:if="{{freightRule}}">
              <view class="summary-row"><text>起步价 / 重量单价</text><text>¥{{freightRule.startPrice}} / ¥{{freightRule.pricePerKg}}/kg</text></view>
              <view class="summary-row"><text>运费</text><text>¥{{expressFreight}}</text></view>
              <view class="summary-row"><text>含税含运费</text><text>¥{{expressTotal}}</text></view>
              <view class="summary-row"><text>不含税含运费</text><text>¥{{expressTotalNoTax}}</text></view>
            </block>
            <text wx:else class="helper-text">{{province ? '暂未配置' : '请选择收货地区'}}</text>
            <block wx:if="{{quoteMode !== 'fixed'}}">
              <text class="detail-title">物流自提</text>
              <block wx:if="{{logisticsRule}}">
                <view class="summary-row"><text>每件运费</text><text>¥{{logisticsRule.pricePerPiece}}</text></view>
                <view class="summary-row"><text>运费</text><text>¥{{logisticsFreight}}</text></view>
                <view class="summary-row"><text>含税含运费</text><text>¥{{logisticsTotal}}</text></view>
                <view class="summary-row"><text>不含税含运费</text><text>¥{{logisticsTotalNoTax}}</text></view>
              </block>
              <text wx:else class="helper-text">{{province ? '暂未配置' : '请选择收货地区'}}</text>
            </block>
          </block>
        </view>
      </block>
    </view>
  </view>

  <view wx:if="{{!uiSearchActive && !uiKeyboardHeight}}" class="bottom-dock">
    <block wx:if="{{uiSection === 'select'}}"><view class="dock-copy"><text class="dock-label">已选 {{cart.length}} 项产品</text><text class="helper-text">可连续添加多个规格</text></view><button class="primary-button dock-button" data-section="cart" bindtap="onUISectionTap">查看清单</button></block>
    <block wx:else>
      <view class="dock-copy">
        <block wx:if="{{quoteMode === 'foreign'}}"><text class="helper-text">FOB Ningbo · USD</text><text class="dock-total">${{foreignTotalUsd}}</text></block>
        <block wx:elif="{{!includeFreight}}"><text class="helper-text">产品合计 · 含税未含运费</text><text class="dock-total">¥{{discountedTotal}}</text></block>
        <block wx:elif="{{!province}}"><text class="helper-text">产品含税合计 · 运费待计算</text><text class="dock-total">¥{{discountedTotal}}</text></block>
        <block wx:elif="{{transportType === 'express' ? freightRule : logisticsRule}}"><text class="helper-text">含税含运费</text><text class="dock-total">¥{{transportType === 'express' ? expressTotal : logisticsTotal}}</text></block>
        <block wx:else><text class="helper-text">产品含税合计 ¥{{discountedTotal}}</text><text class="dock-warning">运费暂未配置</text></block>
      </view>
      <button class="primary-button dock-button" bindtap="onSubmit">预览报价</button>
    </block>
  </view>

  <view wx:if="{{uiToothGuideOpen}}" class="tooth-guide-mask" bindtap="onCloseToothGuide" catchtouchmove="onToothGuideSheetTap">
    <view class="tooth-guide-sheet" catchtap="onToothGuideSheetTap">
      <view class="tooth-guide-header">
        <view><text class="tooth-guide-title">齿型怎么选</text><text class="tooth-guide-subtitle">看侧面结构，快速判断出线方式</text></view>
        <button class="tooth-guide-close" bindtap="onCloseToothGuide" aria-label="关闭齿型说明">×</button>
      </view>
      <view wx:if="{{uiToothGuideHasSpec}}" class="tooth-guide-current">当前规格：{{uiToothGuideSpec}}</view>
      <view wx:else class="tooth-guide-prompt">请先选择规格，选择后会显示对应齿型和孔位参数。</view>
      <scroll-view scroll-y enhanced show-scrollbar="{{false}}" class="tooth-guide-scroll">
        <view wx:for="{{uiToothGuides}}" wx:key="type" class="tooth-guide-card">
          <view wx:if="{{item.image}}" class="tooth-guide-image-wrap"><image class="tooth-guide-image" src="{{item.image}}" mode="widthFix"/></view>
          <view class="tooth-guide-copy">
            <text class="tooth-guide-name">{{item.type}}</text>
            <text class="tooth-guide-description">{{item.description}}</text>
            <view wx:if="{{uiToothGuideHasSpec && item.showParameters}}" class="tooth-guide-parameter">{{item.parameterText}}</view>
            <view wx:elif="{{uiToothGuideHasSpec && item.parameterMissing}}" class="tooth-guide-parameter tooth-guide-missing">{{item.parameterText}}</view>
          </view>
        </view>
        <text wx:if="{{uiToothGuideHasSpec}}" class="tooth-guide-footnote">不同规格支持的齿型可能不同，以上为当前规格可选类型。</text>
        <text wx:else class="tooth-guide-footnote">选择规格后，仅显示该规格真正支持的齿型和对应孔位参数。</text>
        <text class="tooth-guide-symbols">图中 Q 为出线孔宽度，P 为齿宽。</text>
      </scroll-view>
    </view>
  </view>
</view>
