page { background: #F4F6F9; color: #14263D; }
.page { min-height: 100vh; padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #F4F6F9; font-size: 28rpx; line-height: 1.5; }
button { margin: 0; padding: 0; line-height: 1.4; font-size: 28rpx; font-weight: 500; border-radius: 16rpx; }
button::after { border: none; }
.page button { width: auto; margin-left: 0; margin-right: 0; box-sizing: border-box; }
.page .option { width: 100%; min-width: 0; }
.page .clear-search { width: 88rpx; }
.brand-bar, .panel-heading, .result-heading, .selected-spec, .current-price, .list-heading, .item-heading, .item-pricing, .setting-row, .summary-row, .bottom-dock { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.brand-bar { padding: 0 4rpx 24rpx; }
.brand-name { display: block; font-size: 34rpx; font-weight: 700; color: #123764; letter-spacing: -.5rpx; }
.brand-sub { display: block; color: #64748B; font-size: 23rpx; margin-top: 2rpx; }
.text-button { color: #1559C9; background: transparent; min-height: 88rpx; padding: 0 6rpx; display: flex; align-items: center; justify-content: center; font-size: 26rpx; flex-shrink: 0; }
.admin-entry { min-width: 88rpx; min-height: 72rpx; background: white; border: 1rpx solid #E2E8F0; }
.mode-tabs { display: flex; padding: 6rpx; background: #E8EFF8; border-radius: 20rpx; }
.mode-tab { flex: 1; min-width: 0; min-height: 88rpx; padding: 24rpx 4rpx; color: #485C76; background: transparent; }
.mode-tab.is-active { color: #FFF; background: #1559C9; font-weight: 600; box-shadow: 0 4rpx 10rpx rgba(21,89,201,.12); }
.section-tabs { display: flex; gap: 30rpx; margin-bottom: 20rpx; border-bottom: 1rpx solid #DFE5EE; }
.section-tab { background: transparent; border-radius: 0; min-height: 96rpx; padding: 24rpx 8rpx 18rpx; color: #66758A; border-bottom: 4rpx solid transparent; display: flex; align-items: center; gap: 10rpx; }
.section-tab.is-current { color: #1559C9; border-bottom-color: #1559C9; font-weight: 600; }
.count { font-size: 22rpx; padding: 1rpx 10rpx; border-radius: 20rpx; background: #E7EDF6; }
.search-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.search-field { display: flex; align-items: center; flex: 1; min-width: 0; min-height: 92rpx; background: #FFF; border: 2rpx solid #D9E2F0; border-radius: 16rpx; padding-left: 26rpx; }
.search-field-active { border-color: #1559C9; }
.search-icon { width: 25rpx; height: 25rpx; border: 3rpx solid #71829A; border-radius: 50%; position: relative; margin-right: 24rpx; flex-shrink: 0; box-sizing: border-box; }
.search-icon::after { content: ''; position: absolute; width: 13rpx; height: 3rpx; background: #71829A; right: -10rpx; bottom: -5rpx; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 88rpx; font-size: 28rpx; color: #14263D; }
.input-placeholder { color: #7A8CA4; }
.clear-search { width: 88rpx; height: 88rpx; color: #74859A; font-size: 42rpx; background: transparent; flex-shrink: 0; }
.search-cancel { min-width: 72rpx; }
.helper-text { color: #64748B; font-size: 24rpx; line-height: 1.5; display: block; }
.search-results { max-height: 58vh; margin-top: 20rpx; }
.search-result { display: block; width: 100%; box-sizing: border-box; background: #FFF; border: 1rpx solid #E1E7EF; padding: 24rpx; margin-bottom: 16rpx; text-align: left; }
.result-spec { display: block; font-size: 34rpx; font-weight: 650; color: #14263D; }
.dimension-label { display: block; color: #4D6380; margin-top: 6rpx; font-size: 27rpx; }
.result-teeth { margin-top: 10rpx; }
.link-text { color: #1559C9; font-size: 26rpx; white-space: nowrap; }
.manual-link { color: #1559C9; background: transparent; text-align: left; min-height: 96rpx; padding: 24rpx 0; }
.empty-explanation { margin-top: 12rpx; }
.panel { padding: 26rpx; margin-bottom: 22rpx; border-radius: 22rpx; border: 1rpx solid #E8EDF3; background: #FFF; box-sizing: border-box; }
.panel-title { display: block; font-size: 32rpx; font-weight: 650; }
.panel-heading { margin-top: -12rpx; }
.help-note { color: #3F5877; background: #EDF4FF; padding: 20rpx; font-size: 25rpx; border-radius: 12rpx; margin: 4rpx 0 20rpx; }
.field-label { display: block; color: #233B58; font-weight: 550; margin: 22rpx 0 14rpx; }
.unit { font-weight: 400; color: #66758A; margin-left: 6rpx; font-size: 25rpx; }
.dimension-options { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 12rpx; }
.option { background: #F8FAFD; color: #243D5D; border: 1rpx solid #D8E1ED; min-height: 88rpx; padding: 23rpx 4rpx; box-sizing: border-box; }
.option-selected { color: #FFF; border-color: #1559C9; background: #1559C9; font-weight: 600; }
.teeth-options { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 12rpx; }
.dimension-note { margin-top: 22rpx; padding: 16rpx 12rpx; border-radius: 12rpx; background: #EDF4FF; color: #1559C9; font-size: 26rpx; text-align: center; }
.single-color { display: block; margin-top: 18rpx; color: #64748B; font-size: 26rpx; }
.selected-spec { gap: 8rpx; padding-bottom: 8rpx; }
.selected-spec .result-spec { font-size: 32rpx; }
.selected-spec .text-button { font-size: 24rpx; }
.current-price { color: #64748B; font-size: 25rpx; margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #EEF1F5; }
.price-text { display: block; color: #1559C9; font-size: 34rpx; line-height: 1.3; font-weight: 650; overflow-wrap: anywhere; }
.current-price .price-text { font-size: 30rpx; }
.number-field { display: flex; align-items: center; min-height: 98rpx; padding: 0 20rpx; border: 1rpx solid #CBD6E5; border-radius: 14rpx; margin: 18rpx 0 10rpx; }
.number-field input { flex: 1; min-width: 0; font-size: 36rpx; height: 94rpx; font-weight: 600; }
.number-field > text { color: #66758A; margin-left: 12rpx; flex-shrink: 0; }
.meter-hint { margin-top: 6rpx; }
.primary-button { display: flex; align-items: center; justify-content: center; min-height: 96rpx; box-sizing: border-box; padding: 20rpx 24rpx; background: #1559C9; color: #FFF; font-weight: 600; border-radius: 14rpx; }
.add-button { margin-top: 24rpx; width: 100%; }
.list-heading { margin: -10rpx 4rpx 12rpx; }
.empty-state { text-align: center; padding: 48rpx 24rpx; }
.empty-state .helper-text { margin: 16rpx 0 32rpx; }
.cart-item { padding: 22rpx 26rpx; }
.item-heading { align-items: flex-start; }
.item-identity { min-width: 0; flex: 1; }
.item-spec { display: block; font-size: 34rpx; font-weight: 650; word-break: break-word; }
.delete-button { padding: 18rpx 8rpx; min-width: 88rpx; min-height: 88rpx; color: #8A4C53; background: transparent; font-size: 24rpx; margin-top: -12rpx; }
.item-pricing { margin-top: 14rpx; align-items: center; }
.quantity-field { display: flex; align-items: center; width: 238rpx; flex-shrink: 0; border: 1rpx solid #CBD6E5; border-radius: 12rpx; padding: 0 14rpx; height: 88rpx; box-sizing: border-box; }
.quantity-field input { width: 100%; min-width: 0; font-size: 32rpx; height: 84rpx; }
.quantity-field > text { color: #64748B; margin-left: 8rpx; }
.item-amount { min-width: 0; flex: 1; text-align: right; }
.unit-price { margin-top: 12rpx; }
.setting-row { min-height: 92rpx; }
.setting-value { text-align: right; color: #3B5577; min-width: 0; word-break: break-word; }
.muted { color: #8291A5; }
.custom-discount { margin-top: 12rpx; }
.setting-input { height: 92rpx; border: 1rpx solid #CBD6E5; border-radius: 12rpx; padding: 0 18rpx; box-sizing: border-box; font-size: 28rpx; background: #F9FBFE; }
.custom-discount .helper-text { margin-top: 10rpx; }
.exchange-row { display: flex; align-items: center; gap: 16rpx; }
.rate-input { flex: 1; min-width: 0; }
.internal-note { margin-top: 16rpx; padding: 16rpx; background: #F0F5FC; border-radius: 10rpx; }
.region-row { padding-top: 8rpx; }
.delivery-option { display: flex; align-items: center; gap: 16rpx; width: 100%; text-align: left; background: #FFF; border: 1rpx solid #DCE4EF; padding: 18rpx; margin-top: 12rpx; min-height: 112rpx; box-sizing: border-box; }
.delivery-selected { background: #EDF4FF; border-color: #1559C9; }
.radio-mark { width: 36rpx; height: 36rpx; border: 2rpx solid #9CACBF; border-radius: 50%; box-sizing: border-box; flex-shrink: 0; }
.radio-selected { border: 11rpx solid #1559C9; background: #FFF; }
.delivery-copy { flex: 1; min-width: 0; color: #14263D; }
.delivery-copy > text:first-child { font-weight: 550; }
.delivery-copy .helper-text { margin-top: 3rpx; }
.delivery-price { color: #243D5D; font-size: 27rpx; font-weight: 600; text-align: right; flex-shrink: 0; max-width: 190rpx; overflow-wrap: anywhere; }
.delivery-selected .delivery-price { color: #1559C9; }
.summary-row { padding: 10rpx 0; align-items: flex-start; }
.summary-row > text:last-child { text-align: right; overflow-wrap: anywhere; max-width: 58%; }
.secondary { color: #64748B; font-size: 25rpx; }
.disclosure { display: block; color: #4D6380; background: transparent; text-align: left; min-height: 88rpx; width: 100%; padding: 24rpx 0 12rpx; font-size: 26rpx; }
.quote-details { border-top: 1rpx solid #E5EBF3; padding-top: 14rpx; font-size: 25rpx; }
.detail-title { display: block; font-weight: 600; margin-top: 18rpx; }
.bottom-dock { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: #FFF; border-top: 1rpx solid #E1E7EF; box-shadow: 0 -4rpx 16rpx rgba(18,55,100,.035); box-sizing: border-box; }
.dock-copy { min-width: 0; flex: 1; }
.dock-label { display: block; font-size: 29rpx; font-weight: 600; }
.dock-copy .helper-text { font-size: 23rpx; }
.dock-total { display: block; font-size: 40rpx; color: #1559C9; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
.dock-warning { display: block; font-size: 27rpx; color: #5E6E82; }
.dock-button { min-width: 218rpx; max-width: 42%; flex-shrink: 0; }
.ui-hidden { display: none !important; }
@media (max-width: 350px) { .page { padding-left: 22rpx; padding-right: 22rpx; } .panel { padding: 22rpx; } .teeth-options { grid-template-columns: repeat(2,minmax(0,1fr)); } .quantity-field { width: 206rpx; } .price-text { font-size: 31rpx; } }
