.page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.waiting-card {
  width: 100%;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  box-shadow: 0 18rpx 46rpx rgba(31, 41, 55, 0.07);
  text-align: center;
}

.waiting-icon {
  width: 104rpx;
  height: 104rpx;
  margin: 0 auto 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0F3D75, #0A84FF);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(10, 64, 130, 0.22);
}

.waiting-title {
  display: block;
  font-size: 38rpx;
  font-weight: 850;
  color: #1D1D1F;
  margin-bottom: 16rpx;
}

.waiting-desc {
  display: block;
  font-size: 27rpx;
  color: #6E6E73;
  line-height: 1.65;
  margin-bottom: 48rpx;
}

.action-btns {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 800;
  border-radius: 22rpx;
  border: none;
}

.action-btn-primary {
  background: linear-gradient(135deg, #0A84FF, #0066CC);
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(10, 132, 255, 0.26);
}

.action-btn-primary:active {
  opacity: 0.86;
}

.action-btn-secondary {
  background: #FFFFFF;
  color: #0A67CC;
  border: 1rpx solid #CFE3FF;
}

.action-btn-secondary:active {
  background: #EAF4FF;
}
