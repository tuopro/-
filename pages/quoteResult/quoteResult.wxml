<view class="page">

  <view class="loading-wrap" wx:if="{{loading}}">
    <text>正在计算报价…</text>
  </view>

  <view class="quote-hero" wx:if="{{!loading}}">
    <view class="brand-row">
      <view class="brand-image-wrap">
        <image class="brand-product" src="/assets/product-hero.png" mode="aspectFill"></image>
      </view>
      <view class="brand-copy">
        <text class="brand-name">{{quoteMode === 'foreign' ? 'CNDES PVC Wiring Duct' : 'CNDES 德赛线槽'}}</text>
        <text class="brand-sub">{{quoteMode === 'foreign' ? 'Professional Wiring Management' : '线槽正式报价单'}}</text>
      </view>
    </view>
    <view class="quote-hero-title">{{quoteMode === 'foreign' ? 'FOB Ningbo Quotation' : (quoteMode === 'fixed' ? '定长报价明细' : '客户报价明细')}}</view>
    <view class="quote-hero-desc">{{quoteMode === 'foreign' ? 'Prices quoted in USD per meter.' : (quoteMode === 'fixed' ? '单根价格、根数、重量与快运费已汇总。' : '含税价、不含税价、重量件数与运输方案已汇总。')}}</view>
  </view>

  <view class="card foreign-result-card" wx:if="{{!loading && quoteMode === 'foreign'}}">
    <view class="card-title">Product Details</view>
    <scroll-view scroll-x class="foreign-table-scroll">
      <view class="foreign-table">
        <view class="foreign-table-header">
          <text class="foreign-col-spec">Specification</text>
          <text class="foreign-col-type">Type</text>
          <text class="foreign-col-color">Color</text>
          <text class="foreign-col-unit">Unit Price (USD/m)</text>
          <text class="foreign-col-qty">Quantity (m)</text>
          <text class="foreign-col-amount">Amount (USD)</text>
        </view>
        <view class="foreign-table-row {{index % 2 === 1 ? 'foreign-table-row-even' : ''}}"
              wx:for="{{productList}}"
              wx:key="id">
          <text class="foreign-col-spec">{{item.specification}}</text>
          <text class="foreign-col-type">{{item.typeEn}}</text>
          <text class="foreign-col-color">{{item.colorEn}}</text>
          <text class="foreign-col-unit">${{item.fobUnitPriceUsd}}</text>
          <text class="foreign-col-qty">{{item.meters}}</text>
          <text class="foreign-col-amount">${{item.amountUsd}}</text>
        </view>
      </view>
    </scroll-view>
    <view class="foreign-total-row">
      <text>FOB Ningbo Total (USD)</text>
      <text class="foreign-total-value">${{foreignTotalUsd}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{!loading && quoteMode !== 'foreign'}}">
    <view class="card-title">产品明细</view>

    <view class="table-header">
      <text class="col-spec">规格</text>
      <text class="col-price">{{quoteMode === 'fixed' ? '单根价' : '单价'}}</text>
      <text class="col-meters">{{quoteMode === 'fixed' ? '数量' : '米数'}}</text>
      <text class="col-weight">重量</text>
      <text class="col-sub">小计</text>
      <text class="col-dsub" wx:if="{{discount !== 1}}">折后</text>
    </view>

    <view class="table-row {{index % 2 === 1 ? 'table-row-even' : ''}}"
          wx:for="{{productList}}"
          wx:key="id">
      <text class="col-spec">{{item.spec}}{{item.quoteType === 'fixed' ? ' ' + item.fixedLength + '米/根' : ''}}</text>
      <text class="col-price">¥{{item.unitPrice}}</text>
      <text class="col-meters">{{item.quoteType === 'fixed' ? item.quantity + '根' : item.meters}}</text>
      <text class="col-weight">{{item.rowWeight}}kg</text>
      <text class="col-sub">¥{{item.subtotal}}</text>
      <text class="col-dsub" wx:if="{{discount !== 1}}">¥{{item.dsubtotal}}</text>
    </view>

    <view class="table-footer">
      <block wx:if="{{discount !== 1}}">
        <view class="total-line total-line-original">
          <text class="total-label">产品原价合计</text>
          <text class="total-value original">¥{{productTotal}}</text>
        </view>
        <view class="total-line">
          <text class="total-label">产品折后合计</text>
          <text class="total-value">¥{{discountedTotal}}</text>
        </view>
      </block>
      <view class="total-line" wx:else>
        <text class="total-label">产品总价</text>
        <text class="total-value">¥{{productTotal}}</text>
      </view>

      <view class="total-line total-line-notax">
        <text class="total-label">产品不含税总价</text>
        <text class="total-value">¥{{noTaxTotal}}</text>
      </view>

      <view class="total-line total-line-sub">
        <text class="total-label">总重量</text>
        <text class="total-value">{{totalWeight}} kg</text>
      </view>
      <view class="total-line total-line-sub">
        <text class="total-label">{{quoteMode === 'fixed' ? '总根数' : '总件数'}}</text>
        <text class="total-value">{{totalPieces}} {{quoteMode === 'fixed' ? '根' : '件'}}</text>
      </view>
    </view>
  </view>

  <view class="big-total-card" wx:if="{{!loading && quoteMode !== 'foreign' && !includeFreight}}">
    <text class="big-total-label">报价总价（含税）</text>
    <text class="big-total-value">¥{{discountedTotal}}</text>
    <text class="big-total-notax">不含税 ¥{{noTaxTotal}}</text>
  </view>

  <view class="freight-compare" wx:if="{{!loading && quoteMode !== 'foreign' && includeFreight}}">
    <view class="freight-card freight-card-express">
      <view class="freight-header freight-express">{{quoteMode === 'fixed' ? '快运配送' : '快递配送'}}</view>
      <view class="freight-body" wx:if="{{expressConfigured}}">
        <view class="freight-row">
          <text class="fr-label">总重量</text>
          <text class="fr-value">{{totalWeight}} kg</text>
        </view>
        <view class="freight-row">
          <text class="fr-label">起步价</text>
          <text class="fr-value">¥{{freightRule.startPrice}}</text>
        </view>
        <view class="freight-row">
          <text class="fr-label">续重单价</text>
          <text class="fr-value">¥{{freightRule.pricePerKg}}/kg</text>
        </view>
        <view class="freight-row freight-highlight">
          <text class="fr-label">运费</text>
          <text class="fr-value">¥{{expressFreight}}</text>
        </view>
        <view class="freight-total">
          <text class="ft-label">快递总价（含税）</text>
          <text class="ft-value">¥{{expressTotal}}</text>
        </view>
        <view class="freight-total freight-total-notax">
          <text class="ft-label">快递总价（不含税）</text>
          <text class="ft-value-notax">¥{{expressTotalNoTax}}</text>
        </view>
      </view>
      <view class="freight-body freight-empty" wx:else>
        <text class="fr-empty">暂未配置</text>
      </view>
    </view>

    <view class="freight-card freight-card-logistics" wx:if="{{quoteMode !== 'fixed'}}">
      <view class="freight-header freight-logistics">物流自提</view>
      <view class="freight-body" wx:if="{{logisticsConfigured}}">
        <view class="freight-row">
          <text class="fr-label">总件数</text>
          <text class="fr-value">{{totalPieces}} 件</text>
        </view>
        <view class="freight-row">
          <text class="fr-label">单件价格</text>
          <text class="fr-value">¥{{logisticsRule.pricePerPiece}}/件</text>
        </view>
        <view class="freight-row freight-row-placeholder">
          <text class="fr-label">占位</text>
          <text class="fr-value">占位</text>
        </view>
        <view class="freight-row freight-highlight">
          <text class="fr-label">运费</text>
          <text class="fr-value">¥{{logisticsFreight}}</text>
        </view>
        <view class="freight-total">
          <text class="ft-label">自提总价（含税）</text>
          <text class="ft-value">¥{{logisticsTotal}}</text>
        </view>
        <view class="freight-total freight-total-notax">
          <text class="ft-label">自提总价（不含税）</text>
          <text class="ft-value-notax">¥{{logisticsTotalNoTax}}</text>
        </view>
      </view>
      <view class="freight-body freight-empty" wx:else>
        <text class="fr-empty">暂未配置</text>
      </view>
    </view>
  </view>

  <view class="info-bar" wx:if="{{!loading && quoteMode !== 'foreign'}}">
    <view class="info-row">
      <text class="info-icon">折</text>
      <text wx:if="{{discount === 1}}">客户折扣：无</text>
      <text wx:else>客户折扣：{{discountDisplay}}折</text>
    </view>
    <view class="info-row" wx:if="{{includeFreight}}">
      <text class="info-icon">址</text>
      <text>收货地址：{{province}} {{city}}</text>
    </view>
  </view>

  <view class="action-area" wx:if="{{!loading}}">
    <button class="copy-btn" bindtap="onCopy">{{quoteMode === 'foreign' ? 'Copy Quotation' : '复制报价单'}}</button>
    <button class="image-btn" bindtap="onGenerateImage">{{quoteMode === 'foreign' ? 'Generate Image' : '生成报价单图片'}}</button>
  </view>

  <canvas type="2d" id="quoteCanvas" class="hidden-canvas"></canvas>
</view>
