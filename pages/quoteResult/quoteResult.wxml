<view class="page">
  <view wx:if="{{loading}}" class="loading-wrap"><text>正在计算报价…</text></view>
  <block wx:else>
    <view class="quote-brand"><text class="brand-name">{{quoteMode === 'foreign' ? 'CNDES PVC Wiring Duct' : 'CNDES 德赛线槽'}}</text><text class="brand-sub">{{quoteMode === 'foreign' ? 'FOB Ningbo Quotation' : (quoteMode === 'fixed' ? '定长客户报价单' : '客户报价单')}}</text></view>

    <view class="total-panel">
      <block wx:if="{{quoteMode === 'foreign'}}"><text class="total-label">FOB Ningbo Total (USD)</text><text class="total-value">${{foreignTotalUsd}}</text><text class="total-note">Prices quoted in USD per meter.</text></block>
      <block wx:elif="{{!includeFreight}}"><text class="total-label">产品合计（含税，未含运费）</text><text class="total-value">¥{{discountedTotal}}</text><text class="total-note">产品不含税 ¥{{noTaxTotal}}</text></block>
      <block wx:elif="{{uiTransportType === 'express' ? expressConfigured : logisticsConfigured}}"><text class="total-label">报价合计（含税含运费）</text><text class="total-value">¥{{uiTransportType === 'express' ? expressTotal : logisticsTotal}}</text><text class="total-note">不含税含运费 ¥{{uiTransportType === 'express' ? expressTotalNoTax : logisticsTotalNoTax}}</text></block>
      <block wx:else><text class="total-label">产品合计（含税）</text><text class="total-value">¥{{discountedTotal}}</text><text class="total-note">所选配送方式运费暂未配置</text><text class="total-note">产品不含税 ¥{{noTaxTotal}}</text></block>
    </view>

    <view wx:if="{{quoteMode !== 'foreign'}}" class="delivery-summary">
      <view class="delivery-copy"><text class="delivery-name">{{!includeFreight ? '不计运费' : (uiTransportType === 'express' ? '快运送货' : '物流自提')}}</text><text wx:if="{{includeFreight}}" class="delivery-region">{{province}} {{city}}</text><text class="helper-text">{{!includeFreight ? '报价不包含运输费用' : (uiTransportType === 'express' ? '送货上门' : '到当地物流网点提货')}}</text></view>
      <button class="text-button" data-target="delivery" bindtap="onReturnToEdit">修改 ›</button>
    </view>

    <view class="panel">
      <view class="panel-heading"><text class="panel-title">{{quoteMode === 'foreign' ? 'Product Details' : '产品明细'}}</text><button class="text-button" data-target="items" bindtap="onReturnToEdit">{{quoteMode === 'foreign' ? 'Edit ›' : '修改清单 ›'}}</button></view>
      <view wx:if="{{quoteMode === 'foreign'}}" class="foreign-product-list">
        <view class="foreign-product-item" wx:for="{{productList}}" wx:key="id">
          <view class="foreign-product-identity"><text class="product-spec">{{item.specification}} mm</text><text class="helper-text">{{item.typeEn}} · {{item.colorEn}}</text></view>
          <view class="foreign-product-pricing">
            <view><text class="helper-text">Unit Price</text><text>${{item.fobUnitPriceUsd}}/m</text></view>
            <view><text class="helper-text">Quantity</text><text>{{item.meters}} m</text></view>
            <view class="foreign-amount"><text class="helper-text">Amount</text><text class="amount">${{item.amountUsd}}</text></view>
          </view>
        </view>
      </view>
      <view wx:else class="product-list">
        <view class="product-item" wx:for="{{productList}}" wx:key="id">
          <text class="product-spec">{{item.spec}}</text>
          <text wx:if="{{item.quoteType === 'fixed'}}" class="helper-text">{{item.fixedLength}} 米/根</text>
          <view class="product-pricing"><view><text>{{item.quoteType === 'fixed' ? item.quantity + ' 根' : item.meters + ' 米'}}</text><text class="helper-text">¥{{item.unitPrice}} / {{item.quoteType === 'fixed' ? '根' : '米'}}</text></view><view class="amount-copy"><text class="helper-text">{{discount !== 1 ? '折后金额' : '小计'}}</text><text class="amount">¥{{discount !== 1 ? item.dsubtotal : item.subtotal}}</text></view></view>
        </view>
      </view>
      <view wx:if="{{quoteMode !== 'foreign'}}" class="totals-breakdown">
        <view class="summary-row"><text>{{discount !== 1 ? '产品折后合计' : '产品含税合计'}}</text><text class="value">¥{{discountedTotal}}</text></view>
        <view wx:if="{{includeFreight}}" class="summary-row"><text>{{uiTransportType === 'express' ? '快运送货运费' : '物流自提运费'}}</text><text class="value">{{(uiTransportType === 'express' ? expressConfigured : logisticsConfigured) ? '¥' + (uiTransportType === 'express' ? expressFreight : logisticsFreight) : '暂未配置'}}</text></view>
      </view>
    </view>

    <view wx:if="{{quoteMode !== 'foreign'}}" class="panel detail-panel">
      <button class="disclosure" bindtap="onToggleQuoteDetails">{{uiDetailsOpen ? '收起计价明细与配送对比 ⌃' : '查看计价明细与配送对比 ›'}}</button>
      <view wx:if="{{uiDetailsOpen}}">
        <view class="summary-row"><text>产品原价合计</text><text>¥{{productTotal}}</text></view>
        <view class="summary-row"><text>产品折后合计</text><text>¥{{discountedTotal}}</text></view>
        <view class="summary-row"><text>产品不含税合计</text><text>¥{{noTaxTotal}}</text></view>
        <view class="summary-row"><text>客户折扣</text><text>{{discount === 1 ? '无' : discountDisplay + ' 折'}}</text></view>
        <view class="summary-row"><text>总重量</text><text>{{totalWeight}} kg</text></view>
        <view class="summary-row"><text>{{quoteMode === 'fixed' ? '总根数' : '总件数'}}</text><text>{{totalPieces}} {{quoteMode === 'fixed' ? '根' : '件'}}</text></view>
        <view class="line-detail" wx:for="{{productList}}" wx:key="id"><text class="detail-title">{{item.spec}}{{item.quoteType === 'fixed' ? ' ' + item.fixedLength + '米/根' : ''}}</text><view class="summary-row"><text>重量</text><text>{{item.rowWeight}} kg</text></view><view class="summary-row"><text>原价小计</text><text>¥{{item.subtotal}}</text></view><view wx:if="{{discount !== 1}}" class="summary-row"><text>折后金额</text><text>¥{{item.dsubtotal}}</text></view></view>
        <block wx:if="{{includeFreight}}">
          <view class="freight-detail"><text class="detail-title">快运送货</text><block wx:if="{{expressConfigured}}"><view class="summary-row"><text>总重量</text><text>{{totalWeight}} kg</text></view><view class="summary-row"><text>起步价</text><text>¥{{freightRule.startPrice}}</text></view><view class="summary-row"><text>重量单价</text><text>¥{{freightRule.pricePerKg}}/kg</text></view><view class="summary-row"><text>运费</text><text>¥{{expressFreight}}</text></view><view class="summary-row"><text>含税含运费</text><text>¥{{expressTotal}}</text></view><view class="summary-row"><text>不含税含运费</text><text>¥{{expressTotalNoTax}}</text></view></block><text wx:else class="helper-text">暂未配置</text></view>
          <view wx:if="{{quoteMode !== 'fixed'}}" class="freight-detail"><text class="detail-title">物流自提</text><block wx:if="{{logisticsConfigured}}"><view class="summary-row"><text>总件数</text><text>{{totalPieces}} 件</text></view><view class="summary-row"><text>每件运费</text><text>¥{{logisticsRule.pricePerPiece}}</text></view><view class="summary-row"><text>运费</text><text>¥{{logisticsFreight}}</text></view><view class="summary-row"><text>含税含运费</text><text>¥{{logisticsTotal}}</text></view><view class="summary-row"><text>不含税含运费</text><text>¥{{logisticsTotalNoTax}}</text></view></block><text wx:else class="helper-text">暂未配置</text></view>
        </block>
      </view>
    </view>
    <view class="action-area"><button class="primary-button" bindtap="onGenerateImage">{{quoteMode === 'foreign' ? 'Generate Image' : '生成报价图片'}}</button><button class="secondary-button" bindtap="onCopy">{{quoteMode === 'foreign' ? 'Copy Quotation' : '复制报价'}}</button></view>
  </block>
  <canvas type="2d" id="quoteCanvas" class="hidden-canvas"></canvas>
</view>
