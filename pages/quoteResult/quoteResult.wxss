.page {
  min-height: 100vh;
  padding: 28rpx 0 140rpx;
  box-sizing: border-box;
}

.hidden-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.loading-wrap {
  text-align: center;
  padding: 160rpx 0;
  color: #86868B;
  font-size: 28rpx;
}

.quote-hero {
  margin: 0 24rpx 24rpx;
  padding: 34rpx 32rpx;
  color: #fff;
  background: linear-gradient(135deg, #0F3D75 0%, #0A84FF 70%, #4BA3FF 100%);
  border-radius: 34rpx;
  box-shadow: 0 20rpx 52rpx rgba(10, 64, 130, 0.22);
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.brand-image-wrap {
  width: 112rpx;
  height: 92rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.35), 0 12rpx 28rpx rgba(5, 40, 88, 0.16);
  overflow: hidden;
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.brand-product {
  width: 100%;
  height: 100%;
  display: block;
}

.brand-copy {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: 0.2rpx;
  line-height: 1.2;
}

.brand-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.quote-hero-title {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.quote-hero-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
  line-height: 1.55;
}

.card-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #1D1D1F;
  margin-bottom: 24rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #EEF0F4;
}

.big-total-card {
  margin: 24rpx;
  padding: 48rpx 34rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
  box-shadow: 0 18rpx 46rpx rgba(31, 41, 55, 0.07);
  text-align: center;
}

.big-total-label {
  display: block;
  font-size: 26rpx;
  color: #6E6E73;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.big-total-value {
  font-size: 62rpx;
  line-height: 1.15;
  font-weight: 800;
  color: #0A84FF;
}

.big-total-notax {
  display: block;
  margin-top: 10rpx;
  font-size: 27rpx;
  color: #86868B;
}

.table-header,
.table-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EEF0F4;
  font-size: 25rpx;
}

.table-header {
  color: #86868B;
  font-size: 23rpx;
  font-weight: 800;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row-even {
  background: rgba(247, 248, 250, 0.72);
  border-radius: 12rpx;
}

.col-spec {
  flex: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-price {
  flex: 1.2;
  text-align: right;
}

.col-meters {
  flex: 0.8;
  text-align: center;
}

.col-weight {
  flex: 1.2;
  text-align: right;
}

.col-sub {
  flex: 1.2;
  text-align: right;
  font-weight: 700;
  color: #1D1D1F;
}

.col-dsub {
  flex: 1.2;
  text-align: right;
  font-weight: 700;
  color: #0A84FF;
}

.table-footer {
  margin-top: 18rpx;
  padding: 20rpx;
  background: #F7F8FA;
  border-radius: 24rpx;
}

.total-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9rpx 0;
  gap: 20rpx;
}

.total-line-sub {
  font-size: 25rpx;
}

.total-label {
  color: #6E6E73;
}

.total-value {
  font-weight: 800;
  color: #1D1D1F;
}

.total-line-original .total-value.original {
  text-decoration: line-through;
  color: #86868B;
  font-size: 26rpx;
  font-weight: 400;
}

.total-line:not(.total-line-original):not(.total-line-sub) .total-value,
.total-line:first-child:not(.total-line-original) .total-value {
  font-size: 38rpx;
  color: #0A84FF;
  font-weight: 800;
}

.total-line-notax .total-value {
  font-size: 25rpx !important;
  color: #86868B !important;
  font-weight: 500 !important;
}

.freight-compare {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx;
  align-items: stretch;
}

.freight-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 38rpx rgba(31, 41, 55, 0.07);
  overflow: hidden;
  min-width: 0;
  display: flex;
  flex-direction: column;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}

.freight-header {
  text-align: center;
  padding: 18rpx 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #fff;
}

.freight-express {
  background: linear-gradient(135deg, #0A84FF, #0066CC);
}

.freight-logistics {
  background: linear-gradient(135deg, #12A56A, #33C58E);
}

.freight-body {
  padding: 20rpx 16rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.freight-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 9rpx 0;
  font-size: 23rpx;
  gap: 10rpx;
  min-height: 44rpx;
  box-sizing: border-box;
}

.freight-row-placeholder {
  visibility: hidden;
}

.fr-label {
  color: #86868B;
}

.fr-value {
  color: #1D1D1F;
  font-weight: 700;
  text-align: right;
}

.freight-highlight {
  border-top: 1rpx solid #EEF0F4;
  margin-top: 8rpx;
  padding-top: 14rpx;
  min-height: 64rpx;
}

.freight-highlight .fr-value {
  font-size: 32rpx;
  font-weight: 800;
  color: #0A84FF;
}

.freight-card-logistics .freight-highlight .fr-value {
  color: #087B4C;
}

.freight-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 200rpx;
}

.fr-empty {
  color: #B0B0B0;
  font-size: 26rpx;
}

.freight-total {
  margin-top: 16rpx;
  padding: 14rpx 0 4rpx;
  border-top: 1rpx solid #EEF0F4;
  text-align: center;
  min-height: 118rpx;
  box-sizing: border-box;
}

.ft-label {
  display: block;
  font-size: 21rpx;
  color: #86868B;
  margin-bottom: 4rpx;
}

.ft-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #0A84FF;
}

.freight-card-logistics .ft-value {
  color: #087B4C;
}

.freight-total-notax {
  border-top: none;
  margin-top: 0;
  padding-top: 0;
}

.ft-value-notax {
  font-size: 25rpx;
  font-weight: 600;
  color: #86868B;
}

.info-bar {
  margin: 24rpx;
  padding: 24rpx 28rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 30rpx rgba(31, 41, 55, 0.05);
  font-size: 26rpx;
  color: #6E6E73;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
}

.info-row:first-child {
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  border-bottom: 1rpx solid #EEF0F4;
}

.info-icon {
  width: 38rpx;
  height: 38rpx;
  border-radius: 12rpx;
  background: #EAF4FF;
  color: #0A67CC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.action-area {
  display: flex;
  gap: 16rpx;
  margin: 24rpx;
}

.copy-btn,
.image-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  font-size: 29rpx;
  font-weight: 800;
  border-radius: 24rpx;
  border: none;
  padding: 0;
}

.copy-btn {
  background: #FFFFFF;
  color: #0A67CC;
  border: 1rpx solid #CFE3FF;
}

.copy-btn:active {
  background: #EAF4FF;
}

.image-btn {
  background: linear-gradient(135deg, #0A84FF, #0066CC);
  color: #fff;
  box-shadow: 0 14rpx 30rpx rgba(10, 132, 255, 0.26);
}

.image-btn:active {
  opacity: 0.86;
}

.foreign-result-card {
  overflow: hidden;
}

.foreign-table-scroll {
  width: 100%;
}

.foreign-table {
  min-width: 1050rpx;
}

.foreign-table-header,
.foreign-table-row {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.foreign-table-header {
  color: #667085;
  background: #F7F9FC;
  font-size: 22rpx;
  font-weight: 700;
}

.foreign-table-row {
  color: #101828;
  border-bottom: 1rpx solid #EEF0F4;
  font-size: 24rpx;
}

.foreign-table-row-even {
  background: rgba(247, 249, 252, 0.72);
}

.foreign-col-spec {
  width: 160rpx;
}

.foreign-col-type {
  width: 180rpx;
}

.foreign-col-color {
  width: 120rpx;
}

.foreign-col-unit {
  width: 210rpx;
  text-align: right;
}

.foreign-col-qty {
  width: 160rpx;
  text-align: right;
}

.foreign-col-amount {
  width: 180rpx;
  text-align: right;
  color: #0A84FF;
  font-weight: 700;
}

.foreign-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #F0F7FF;
  color: #344054;
  font-size: 27rpx;
  font-weight: 700;
}

.foreign-total-value {
  color: #0A84FF;
  font-size: 42rpx;
  font-weight: 800;
}
