page { background: #F4F6F9; color: #14263D; }
.page { min-height: 100vh; padding: 30rpx 28rpx calc(270rpx + env(safe-area-inset-bottom)); box-sizing: border-box; background: #F4F6F9; font-size: 28rpx; line-height: 1.5; }
button { margin: 0; padding: 0; line-height: 1.4; font-family: inherit; font-size: 28rpx; }
button::after { border: none; }
.page button { width: auto; margin-left: 0; margin-right: 0; box-sizing: border-box; }
.quote-brand { text-align: center; padding: 10rpx 0 30rpx; }
.brand-name { display: block; color: #123764; font-size: 38rpx; font-weight: 700; }
.brand-sub { display: block; color: #64748B; font-size: 28rpx; margin-top: 4rpx; }
.total-panel { background: #EDF4FF; border: 1rpx solid #DCE9FA; border-radius: 24rpx; padding: 30rpx 20rpx; text-align: center; margin-bottom: 20rpx; }
.total-label { display: block; font-size: 28rpx; color: #244264; }
.total-value { display: block; color: #1559C9; font-size: 66rpx; font-weight: 700; line-height: 1.25; padding: 8rpx 0; overflow-wrap: anywhere; }
.total-note { display: block; color: #4D6380; font-size: 26rpx; margin-top: 6rpx; }
.panel { background: #FFF; border: 1rpx solid #E5EBF3; border-radius: 22rpx; padding: 10rpx 26rpx 24rpx; margin-bottom: 20rpx; }
.panel-heading, .product-pricing, .summary-row, .delivery-summary { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }
.panel-title { font-size: 32rpx; font-weight: 650; }
.text-button { background: transparent; color: #1559C9; font-size: 26rpx; min-height: 88rpx; padding: 22rpx 0; box-sizing: border-box; flex-shrink: 0; }
.delivery-summary { background: #FFF; padding: 20rpx 26rpx; border-radius: 18rpx; margin-bottom: 20rpx; border: 1rpx solid #E5EBF3; }
.delivery-copy { flex: 1; min-width: 0; }
.delivery-name { font-weight: 650; margin-right: 16rpx; }
.delivery-region { color: #3B5577; }
.helper-text { display: block; color: #64748B; font-size: 24rpx; line-height: 1.5; }
.delivery-copy .helper-text { margin-top: 6rpx; }
.product-item, .foreign-product-item { padding: 22rpx 0; border-top: 1rpx solid #E9EEF5; }
.product-spec { display: block; font-size: 29rpx; font-weight: 600; word-break: break-word; }
.product-pricing { margin-top: 14rpx; align-items: flex-start; }
.amount-copy { min-width: 0; max-width: 60%; text-align: right; }
.amount { display: block; color: #14263D; font-size: 32rpx; font-weight: 650; overflow-wrap: anywhere; }
.foreign-product-pricing { display: grid; grid-template-columns: minmax(0,1.1fr) minmax(0,.8fr) minmax(0,1fr); gap: 16rpx; margin-top: 18rpx; font-size: 26rpx; }
.foreign-product-pricing > view { min-width: 0; overflow-wrap: anywhere; }
.foreign-product-pricing .helper-text { font-size: 22rpx; margin-bottom: 3rpx; }
.foreign-amount { text-align: right; }
.foreign-amount .amount { font-size: 29rpx; }
.totals-breakdown { border-top: 1rpx solid #E1E8F1; padding-top: 18rpx; }
.summary-row { padding: 9rpx 0; font-size: 26rpx; align-items: flex-start; }
.summary-row > text:last-child { max-width: 58%; overflow-wrap: anywhere; text-align: right; }
.value { font-weight: 600; }
.detail-panel { padding-top: 0; padding-bottom: 0; }
.disclosure { color: #4D6380; background: transparent; width: 100%; text-align: left; min-height: 96rpx; padding: 24rpx 0; box-sizing: border-box; font-size: 26rpx; }
.line-detail, .freight-detail { border-top: 1rpx solid #E5EBF3; margin-top: 16rpx; padding: 18rpx 0; }
.detail-title { display: block; color: #264466; font-size: 27rpx; font-weight: 600; margin-bottom: 6rpx; }
.action-area { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: #FFF; border-top: 1rpx solid #E1E7EF; z-index: 10; }
.primary-button, .secondary-button { display: flex; align-items: center; justify-content: center; min-height: 92rpx; padding: 20rpx; box-sizing: border-box; border-radius: 14rpx; font-weight: 600; }
.primary-button { background: #1559C9; color: #FFF; }
.secondary-button { background: #FFF; color: #1559C9; border: 2rpx solid #1559C9; margin-top: 12rpx; }
.loading-wrap { padding: 120rpx 20rpx; text-align: center; color: #64748B; }
.hidden-canvas { position: fixed; left: -9999px; top: -9999px; width: 375px; height: 1px; pointer-events: none; }
@media (max-width: 350px) { .page { padding-left: 22rpx; padding-right: 22rpx; } .panel { padding-left: 22rpx; padding-right: 22rpx; } .total-value { font-size: 59rpx; } .brand-name { font-size: 34rpx; } }
